# 完整版本：原有配置 + WiFi服务/触发器 + 导入init.recovery.wifi.rc

# 导入独立WiFi配置文件（必须放在开头）
import /init.recovery.wifi.rc

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on init
    setprop sys.usb.configfs 1
    start vendor.boot-qti
    start vendor.gatekeeper_default

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    mkdir /tmp/persist 0775 shell system
    mount none /tmp/persist /mnt/vendor/persist bind rec
    install_keyring

on post-fs
    setprop twrp.variant.files_copied 0

on property:twrp.modules.loaded=true
    # Mount firmware
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/ssr
    write /sys/kernel/boot_adsp/ssr 1
    wait /sys/class/power_supply/battery
    start vendor.health-default
    # 触发WiFi驱动复制服务（关联init.recovery.wifi.rc）
    write /dev/kmsg "[jasonwifi][modules] Trigger cp-wifi-ko service"
    start cp-wifi-ko

on property:servicemanager.ready=true
    setprop sys.boot_completed 1
    start vendor.ssgtzd

on property:twrp.variant.files_copied=1
    umount /firmware
    umount /vendor
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /vendor/firmware_mnt ro
    start vendor.se_omapi

# ================================== WiFi 核心服务 ==================================
# Add by jason - WiFi相关服务定义（适配设备树真实路径）
service vendor.qrtr-ns /vendor/bin/qrtr-ns -f
    disabled
    user root
    group root
    capabilities NET_BIND_SERVICE
    seclabel u:r:recovery:s0

service vendor.rmt_storage /vendor/bin/rmt_storage
    disabled
    user root
    ioprio rt 0
    seclabel u:r:recovery:s0

service vendor.tftp_server /vendor/bin/tftp_server
    disabled
    user root
    seclabel u:r:recovery:s0

service vendor.per_mgr /vendor/bin/pm-service
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

service vendor.pd_mapper /vendor/bin/pd-mapper
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

service vendor.per_proxy /vendor/bin/pm-proxy
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

# WiFi守护进程（wpa_supplicant依赖）
service cnss-daemon /vendor/bin/cnss-daemon -n -l
    disabled
    user root
    group root system inet net_admin wifi
    capabilities NET_ADMIN
    seclabel u:r:recovery:s0

# WiFi核心服务（设备树真实路径：/vendor/bin/hw/wpa_supplicant）
service wpa_supplicant /vendor/bin/hw/wpa_supplicant -Dnl80211 -iwlan0 -dd -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    seclabel u:r:recovery:s0
    user root
    group root wifi net_raw  # 适配WiFi通信权限

# DHCP服务（获取IP地址）
service dhcpcd /system/bin/dhcpcd wlan0 -B
    disabled
    oneshot
    seclabel u:r:recovery:s0

# WiFi驱动复制服务（设备树真实路径：/system/bin/cp-wifi-ko.sh）
service cp-wifi-ko /system/bin/cp-wifi-ko.sh
    disabled
    oneshot
    seclabel u:r:recovery:s0

# ================================== WiFi 触发器 ==================================
# 1. 驱动复制完成后触发模块加载
on property:twrp.cpko=true
    write /dev/kmsg "[jasonwifi][driver] Start load WiFi kernel modules"
    # 模块加载顺序：基础模块→核心模块→芯片专用模块（严格遵循依赖规则）
    # 基础模块（cfg80211为所有WiFi模块依赖）
    wait /odm/wifi/modules/cfg80211.ko 10 || { write /dev/kmsg "[jasonwifi] cfg80211.ko not found!"; exit 1; }
    insmod /odm/wifi/modules/cfg80211.ko || { write /dev/kmsg "[jasonwifi] cfg80211.ko load failed!"; exit 1; }
    wait /odm/wifi/modules/rfkill.ko 10 || { write /dev/kmsg "[jasonwifi] rfkill.ko not found!"; exit 1; }
    insmod /odm/wifi/modules/rfkill.ko || { write /dev/kmsg "[jasonwifi] rfkill.ko load failed!"; exit 1; }
    
    # 高通核心模块（依赖cfg80211）
    wait /odm/wifi/modules/cnss_prealloc.ko 10 || { write /dev/kmsg "[jasonwifi] cnss_prealloc.ko not found!"; exit 1; }
    insmod /odm/wifi/modules/cnss_prealloc.ko || { write /dev/kmsg "[jasonwifi] cnss_prealloc.ko load failed!"; exit 1; }
    wait /odm/wifi/modules/cnss_nl.ko 10 || { write /dev/kmsg "[jasonwifi] cnss_nl.ko not found!"; exit 1; }
    insmod /odm/wifi/modules/cnss_nl.ko || { write /dev/kmsg "[jasonwifi] cnss_nl.ko load failed!"; exit 1; }
    wait /odm/wifi/modules/wlan_firmware_service.ko 10 || { write /dev/kmsg "[jasonwifi] wlan_firmware_service.ko not found!"; exit 1; }
    insmod /odm/wifi/modules/wlan_firmware_service.ko || { write /dev/kmsg "[jasonwifi] wlan_firmware_service.ko load failed!"; exit 1; }
    wait /odm/wifi/modules/cnss_plat_ipc_qmi_svc.ko 10 || { write /dev/kmsg "[jasonwifi] cnss_plat_ipc_qmi_svc.ko not found!"; exit 1; }
    insmod /odm/wifi/modules/cnss_plat_ipc_qmi_svc.ko || { write /dev/kmsg "[jasonwifi] cnss_plat_ipc_qmi_svc.ko load failed!"; exit 1; }
    wait /odm/wifi/modules/cnss_utils.ko 10 || { write /dev/kmsg "[jasonwifi] cnss_utils.ko not found!"; exit 1; }
    insmod /odm/wifi/modules/cnss_utils.ko || { write /dev/kmsg "[jasonwifi] cnss_utils.ko load failed!"; exit 1; }
    wait /odm/wifi/modules/cnss2.ko 10 || { write /dev/kmsg "[jasonwifi] cnss2.ko not found!"; exit 1; }
    insmod /odm/wifi/modules/cnss2.ko || { write /dev/kmsg "[jasonwifi] cnss2.ko load failed!"; exit 1; }
    
    # 辅助模块（非必需，加载失败仅日志提示）
    wait /odm/wifi/modules/gsim.ko 10
    insmod /odm/wifi/modules/gsim.ko || write /dev/kmsg "[jasonwifi] gsim.ko load failed (non-essential)"
    wait /odm/wifi/modules/rmnet_mem.ko 10
    insmod /odm/wifi/modules/rmnet_mem.ko || write /dev/kmsg "[jasonwifi] rmnet_mem.ko load failed (non-essential)"
    wait /odm/wifi/modules/ipam.ko 10
    insmod /odm/wifi/modules/ipam.ko || write /dev/kmsg "[jasonwifi] ipam.ko load failed (non-essential)"
    
    # 芯片专用模块（kiwi_v2，适配设备树）
    wait /odm/wifi/modules/qca_cld3_kiwi_v2.ko 10 || { write /dev/kmsg "[jasonwifi] qca_cld3_kiwi_v2.ko not found!"; exit 1; }
    insmod /odm/wifi/modules/qca_cld3_kiwi_v2.ko || { write /dev/kmsg "[jasonwifi] qca_cld3_kiwi_v2.ko load failed!"; exit 1; }
    
    write /dev/kmsg "[jasonwifi][driver] All essential WiFi modules loaded!"
    setprop twrp.insmodko 1

# 2. 模块加载完成后触发服务启动
on property:twrp.insmodko=1
    write /dev/kmsg "[jasonwifi][service] Trigger WiFi services start"
    setprop qcomwlan.driver.load true

# 3. 驱动就绪后启动cnss-daemon和wpa_supplicant
on property:qcomwlan.driver.load=true
    write /dev/kmsg "[jasonwifi][interface] Waiting for wlan0 interface"
    wait /sys/class/net/wlan0 15  # 延长超时，确保接口创建
    if [ -e "/sys/class/net/wlan0" ]; then
        write /dev/kmsg "[jasonwifi][interface] wlan0 interface created"
        setprop jasonwifi.driver.ready true
    else
        write /dev/kmsg "[jasonwifi][interface] wlan0 create failed!"
        exit 1
    fi

# 4. 启动核心服务（先cnss-daemon，后wpa_supplicant）
on property:jasonwifi.driver.ready=true
    write /dev/kmsg "[jasonwifi][service] Start core WiFi services"
    # 创建sockets目录（权限适配wpa_cli）
    mkdir /tmp/recovery 0777 root root
    mkdir /tmp/recovery/sockets 0770 root wifi
    # 启动依赖服务
    start cnss-daemon
    write /dev/kmsg "[jasonwifi][service] cnss-daemon started"
    # 启动wpa_supplicant
    start wpa_supplicant
    write /dev/kmsg "[jasonwifi][service] wpa_supplicant started (sockets: /tmp/recovery/sockets)"

# 5. wpa_supplicant状态监控
on property:supplicant.status=running
    start wpa_supplicant
    write /dev/kmsg "[jasonwifi][wpa_supplicant] Service running"

on property:supplicant.status=stopped
    stop wpa_supplicant
    write /dev/kmsg "[jasonwifi][wpa_supplicant] Service stopped"

# 6. 高通服务启动触发器（可选：ADB手动触发）
on property:survival.start.service=true
    write /dev/kmsg "[jasonwifi][service] Starting Qualcomm auxiliary services"
    start vendor.pd_mapper
    start vendor.per_proxy
    start vendor.per_mgr
    start vendor.qrtr-ns
    start vendor.rmt_storage
    start vendor.tftp_server
    write /dev/kmsg "[jasonwifi][service] Qualcomm auxiliary services started"
# ================================== WiFi 配置结束 ==================================
