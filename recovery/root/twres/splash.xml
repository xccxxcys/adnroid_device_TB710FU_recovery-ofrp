<?xml version="1.0"?>
<!-- 
	OrangeFox Splash - 强制拉伸1080x1920 original.png 适配3200x2000横屏
	核心：禁用图片比例保持，强制拉伸至全屏无黑边
-->
<recovery>
	<details>
		<resolution width="3200" h="2000"/> <!-- 目标屏幕分辨率（横屏） -->
		<themeversion>3</themeversion>
	</details>
	
	<resources>
		<image name="splash_logo_w" filename="Splash/logo_w" retainaspect="1"/> <!-- Logo保持比例，避免变形 -->
		<image name="splash_bg" filename="Splash/original" retainaspect="0"/> <!-- 关键：0=强制拉伸，忽略原图比例 -->
		<font name="of" filename="EuclidFlex-Medium.ttf" size="90"/> <!-- 高分辨率适配：放大字体 -->
		<font name="recovery" filename="EuclidFlex-Regular.ttf" size="78"/>
	</resources>
	<variables>
		<variable name="of" value="%screen_h%-650"/> <!-- 文字纵向位置调整，避免被Logo遮挡 -->
		<variable name="rec" value="%screen_h%-550"/>
		<variable name="screen_width" value="3200"/> <!-- 同步屏幕宽高 -->
		<variable name="screen_height" value="2000"/>
		<variable name="header_color" value="#000000"/> <!-- 背景色兜底（图片加载失败时显示） -->
		<variable name="background_color" value="#000000"/>
	</variables>
	<pages>
		<page name="splash">
			<background color="%background_color%"/>
			<fill color="%header_color%">
				<placement x="0" y="0" w="%screen_width%" h="%screen_height%"/> <!-- 全屏填充背景色 -->
			</fill>
			<image>
				<image resource="splash_bg"/>
				<!-- 强制拉伸1080x1920图片至3200x2000，x/y=0贴边，w/h=屏幕尺寸 -->
				<placement x="0" y="0" w="%screen_width%" h="%screen_height%"/>
			</image>
			<image>
				<image resource="splash_logo_w"/>
				<placement x="1600" y="%center_y%" placement="4"/> <!-- Logo水平+垂直居中 -->
			</image>
			<text style="menu_text">
				<placement x="1600" y="%of%" placement="4"/> <!-- 文字水平居中 -->
				<font resource="of" color="#ffffff"/>
				<text>OrangeFox</text>
			</text>
			<text style="menu_text">
				<placement x="1600" y="%rec%" placement="4"/>
				<font resource="recovery" color="#ffffff"/>
				<text>Recovery</text>
			</text>
		</page>
	</pages>
</recovery>
