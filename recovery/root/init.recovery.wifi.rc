# 完整WiFi配置文件（适配Lenovo TB710FU/topaz设备树）
# 仅包含WiFi相关目录创建、符号链接、权限配置，无冗余内容

on init
    ######## Add by jason
    # 阶段1：初始化WiFi基础目录与符号链接
    write /dev/kmsg "[jasonwifi][init] WiFi configuration started (init.recovery.wifi.rc)"

    # 1.1 固件路径符号链接（指向设备树实际固件目录）
    symlink /vendor/firmware /etc/firmware
    write /dev/kmsg "[jasonwifi][init] Firmware symlink: /etc/firmware -> /vendor/firmware"

    # 1.2 创建WiFi配置目录结构（严格匹配设备树存在的kiwi_v2/qca6750）
    mkdir /vendor/firmware/wlan 0770 root wifi  # WiFi服务专属权限
    mkdir /vendor/firmware/wlan/qca_cld 0770 root wifi
    mkdir /vendor/firmware/wlan/qca_cld/kiwi_v2 0770 root wifi  # 设备树默认芯片配置
    mkdir /vendor/firmware/wlan/qca_cld/qca6750 0770 root wifi  # 备选芯片配置
    write /dev/kmsg "[jasonwifi][init] Config directories created: kiwi_v2/qca6750"

    # 1.3 符号链接设备树真实配置文件
    # 默认使用kiwi_v2（适配设备树主要配置）
    symlink /vendor/etc/wifi/kiwi_v2/WCNSS_qcom_cfg.ini /vendor/firmware/wlan/qca_cld/kiwi_v2/WCNSS_qcom_cfg.ini
    symlink /vendor/etc/wifi/kiwi_v2/WCNSS_qcom_cfg.ini /vendor/firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini
    # 备选qca6750配置（预留切换能力）
    symlink /vendor/etc/wifi/qca6750/WCNSS_qcom_cfg.ini /vendor/firmware/wlan/qca_cld/qca6750/WCNSS_qcom_cfg.ini
    write /dev/kmsg "[jasonwifi][init] Config symlinks created (default: kiwi_v2)"

    # 1.4 初始化wpa_supplicant工作目录
    mkdir /data/misc 0755 root root
    mkdir /data/misc/wifi 0770 root wifi  # 仅root/wifi组可读写，防权限泄露
    write /dev/kmsg "[jasonwifi][init] wpa_supplicant work dir: /data/misc/wifi"

    # 阶段2：设置全路径权限（覆盖设备树所有WiFi相关文件）
    # 2.1 /vendor/etc/wifi/ 配置文件权限
    chmod 0755 /vendor/etc/wifi/
    chmod 0755 /vendor/etc/wifi/kiwi_v2/
    chmod 0755 /vendor/etc/wifi/qca6750/
    chmod 0644 /vendor/etc/wifi/kiwi_v2/WCNSS_qcom_cfg.ini
    chmod 0644 /vendor/etc/wifi/qca6750/WCNSS_qcom_cfg.ini
    chmod 0644 /vendor/etc/wifi/wpa_supplicant.conf
    chmod 0644 /vendor/etc/wifi/p2p_supplicant_overlay.conf
    chmod 0644 /vendor/etc/wifi/vendor_cmd.xml
    # 2.2 /vendor/firmware/wlan/ 固件配置目录权限
    chown -R root:wifi /vendor/firmware/wlan/
    chmod 0644 /vendor/firmware/wlan/qca_cld/*.ini
    chmod 0644 /vendor/firmware/wlan/qca_cld/kiwi_v2/*.ini
    chmod 0644 /vendor/firmware/wlan/qca_cld/qca6750/*.ini
    # 2.3 WiFi工具与服务权限（关联设备树真实路径）
    chmod 0755 /system/bin/cp-wifi-ko.sh
    chmod 0755 /system/bin/netscan.sh
    chmod 0755 /system/bin/netconnect.sh
    chmod 0755 /system/bin/netinfo.sh
    chmod 0755 /vendor/bin/hw/wpa_supplicant
    chmod 0755 /vendor/bin/cnss-daemon
    write /dev/kmsg "[jasonwifi][init] All WiFi files/dirs permission set successfully"

    write /dev/kmsg "[jasonwifi][init] WiFi init prepare completed!"
    ######## Add End

on post-fs-data
    ######## Add by jason
    # 阶段3：persist分区挂载后创建MAC地址文件链接（确保MAC地址正常读取）
    write /dev/kmsg "[jasonwifi][post-fs-data] Start create wlan_mac.bin symlink"
    if [ -d "/mnt/vendor/persist" ] && [ -f "/mnt/vendor/persist/wlan_mac.bin" ]; then
        # 链接MAC地址文件到WiFi配置目录
        symlink /mnt/vendor/persist/wlan_mac.bin /vendor/etc/wifi/wlan_mac.bin
        # 设置MAC文件权限
        chmod 0644 /vendor/etc/wifi/wlan_mac.bin
        chown root:wifi /vendor/etc/wifi/wlan_mac.bin
        write /dev/kmsg "[jasonwifi][post-fs-data] wlan_mac.bin linked: /vendor/etc/wifi/wlan_mac.bin"
    else
        write /dev/kmsg "[jasonwifi][post-fs-data] Warning: persist/wlan_mac.bin not found (ignore if not required)"
    fi
    ######## Add End

on boot
    ######## Add by jason
    # 阶段4：WiFi启动环境优化（删除无效操作，保留核心配置）
    write /dev/kmsg "[jasonwifi][boot] Optimize WiFi boot env"
    # 启用WLAN SSR恢复机制
    if [ -e "/sys/kernel/cnss/recovery" ]; then
        write /sys/kernel/cnss/recovery 3
        write /dev/kmsg "[jasonwifi][boot] WLAN SSR recovery enabled"
    fi
    # 设置唤醒锁权限（适配Recovery环境）
    chmod 0660 /sys/power/wake_lock
    chmod 0660 /sys/power/wake_unlock
    write /dev/kmsg "[jasonwifi][boot] WiFi boot env optimized"
    ######## Add End
